{
  "version": 8,
  "dashboardId": "business_metrics",
  "title": "Business Metrics",
  "description": "Business signal only: registrations, users by auth type, orders and their delivery state, and email outcomes. HTTP status codes are deliberately NOT here — they are technical health, not business, and each service's own Golden Signals dashboard already carries them. Two tabs: \"At a glance\" for the current number of each metric, \"Trends\" for how it moved. PANELS USE PromQL, NOT SQL: the UI dispatches on queryType, and a metrics stream queried with queryType sql renders 'Error Loading Data' without ever issuing a search request. Dimension names arrive prefixed and lowercased (CloudWatch `Service` -> `dimensions_service`), and the metric name becomes the stream name (amazonaws.com/3MRAI/orders_total -> amazonaws_com_3mrai_orders_total). Gauges use max(); counters use sum().",
  "role": "",
  "owner": "3MRAI",
  "created": "2026-08-12T00:00:00.000Z",
  "tabs": [
    {
      "tabId": "trends",
      "name": "Trends",
      "panels": [
        {
          "id": "users_registered",
          "type": "line",
          "title": "Users registered",
          "description": "New registrations. Both the password and passwordless paths increment this one counter — the split is carried by users_total's HasPassword dimension, not by a second metric.",
          "config": {
            "show_legends": false,
            "decimals": 0
          },
          "queryType": "promql",
          "queries": [
            {
              "query": "amazonaws_com_3mrai_users_registered_total",
              "customQuery": true,
              "fields": {
                "stream": "amazonaws_com_3mrai_users_registered_total",
                "stream_type": "metrics",
                "x": [],
                "y": [],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                },
                "breakdown": []
              },
              "config": {
                "promql_legend": "registrations",
                "layer_type": "scatter",
                "weight_fixed": 1
