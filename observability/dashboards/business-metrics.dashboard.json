          "id": "emails_sent",
          "type": "line",
          "title": "Emails sent",
          "description": "The EmailType=ALL rollup, which is a SEPARATELY PUBLISHED series rather than a query-time aggregate: CloudWatch under Floci does not aggregate across dimensions, so a query omitting EmailType returns an empty result with StatusCode 'Complete'. NOTE: this counts handoff to SES, not inbox delivery — bounces and complaints are invisible here.",
          "config": {
            "show_legends": true,
            "decimals": 0,
            "legends_position": "bottom"
