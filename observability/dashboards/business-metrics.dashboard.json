        {
          "id": "orders_by_tracking_status",
          "type": "bar",
          "title": "Orders — finished vs in progress (Tracking service)",
          "description": "Live orders split by whether tracking considers them finished. DELIVERED is the state machine's terminal status; everything else is IN_PROGRESS. The pre-summed ALL series is excluded — it is the sum of these two, so charting it alongside them would always give the tallest bar and flatten the comparison (the total has its own card). A GAUGE, so max(): sum() would add every sample in the window and report a multiple of the count.",
          "config": {
            "show_legends": true,
            "decimals": 0
          },
          "queryType": "promql",
          "queries": [
            {
              "query": "max by (dimensions_status) (amazonaws_com_3mrai_orders_by_tracking_status_total{dimensions_status!=\"ALL\"})",
