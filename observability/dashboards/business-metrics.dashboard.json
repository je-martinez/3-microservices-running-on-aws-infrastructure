            "h": 13,
            "i": 1
          }
        },
        {
          "id": "users_by_auth_type",
          "type": "line",
          "title": "Users by auth type",
          "description": "Live user count split by whether the account has a password (the OTP flow creates users with none). A GAUGE, so max() — sum() would add every sample in the window and report a multiple of the real count. Both series are always published, zero included, so a value with no users reads as 0 rather than as a gap.",
          "config": {
            "show_legends": true,
            "decimals": 0,
            "legends_position": "bottom"
          },
          "queryType": "promql",
          "queries": [
            {
              "query": "max by (dimensions_haspassword) (amazonaws_com_3mrai_users_total)",
              "customQuery": true,
              "fields": {
                "stream": "amazonaws_com_3mrai_users_total",
                "stream_type": "metrics",
                "x": [],
                "y": [],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "has password: {dimensions_haspassword}",
                "layer_type": "scatter",
                "weight_fixed": 1
              }
            }
          ],
          "layout": {
            "x": 12,
            "y": 0,
            "w": 12,
            "h": 13,
            "i": 2
          }
        },
