        {
          "id": "users_by_auth_type",
          "type": "line",
          "title": "Users by auth type",
          "description": "Live user count split by whether the account has a password (the OTP flow creates users with none). A GAUGE, so max() \u2014 sum() would add every sample in the window and report a multiple of the real count. Both series are always published, zero included, so a value with no users reads as 0 rather than as a gap.",
          "config": {
            "show_legends": true,
            "decimals": 0
          },
          "queryType": "promql",
          "queries": [
            {
              "query": "max by (dimensions_haspassword) (amazonaws_com_3mrai_users_total)",
