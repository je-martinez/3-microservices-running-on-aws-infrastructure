          }
        },
        {
          "id": "users_by_auth_type",
          "type": "line",
          "title": "Users by sign-in method",
          "description": "Live user count split by HOW the account signs in: with a password, or with an emailed OTP code. Not 'has a password' — a passwordless account does have a Cognito password (signUp requires one, so registration generates a random one), but it is never given to the user and password login is rejected for them. The underlying dimension is still HasPassword=true/false; label_replace renames it at query time so historical data keeps working. The ALL series is excluded here — it is the pre-summed total and would dwarf both real series. A GAUGE, so max(): sum() would add every sample in the window and report a multiple of the real count.",
          "config": {
            "show_legends": true,
            "decimals": 0
          },
          "queryType": "promql",
          "queries": [
            {
              "query": "label_replace(label_replace(max by (dimensions_haspassword) (amazonaws_com_3mrai_users_total{dimensions_haspassword!=\"ALL\"}), \"method\", \"Password login\", \"dimensions_haspassword\", \"true\"), \"method\", \"Email OTP\", \"dimensions_haspassword\", \"false\")",
              "customQuery": true,
              "fields": {
                "stream": "amazonaws_com_3mrai_users_total",
                "stream_type": "metrics",
                "x": [],
                "y": [],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                },
                "breakdown": []
              },
              "config": {
                "promql_legend": "{method}",
                "layer_type": "scatter",
                "weight_fixed": 1
              }
            }
          ],
          "layout": {
            "x": 96,
            "y": 0,
            "w": 96,
            "h": 15,
            "i": 2
          }
        },
