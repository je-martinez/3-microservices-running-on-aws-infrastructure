{
  "version": 8,
  "dashboardId": "business_metrics",
  "title": "Business Metrics",
  "description": "Custom business and HTTP error metrics: services publish with PutMetricData to CloudWatch, the collector's aws_cloudwatch receiver scrapes them with GetMetricData, and they land in OpenObserve as metric streams. PANELS USE PromQL, NOT SQL: the UI dispatches on queryType, and a metrics stream queried with queryType sql renders 'Error Loading Data' without ever issuing a search request. Dimension names arrive prefixed and lowercased (CloudWatch `Service` -> `dimensions_service`), and the metric name becomes the stream name (amazonaws.com/3MRAI/orders_total -> amazonaws_com_3mrai_orders_total). Gauges use max(); counters use sum().",
  "role": "",
  "owner": "3MRAI",
  "created": "2026-08-12T00:00:00.000Z",
  "tabs": [
    {
      "tabId": "default",
      "name": "Default",
      "panels": [
        {
          "id": "users_registered",
          "type": "line",
          "title": "Users registered",
          "description": "New registrations. Both the password and passwordless paths increment this one counter — the split is carried by users_total's HasPassword dimension, not by a second metric.",
          "config": {
            "show_legends": true,
            "decimals": 0,
            "legends_position": "bottom"
          },
          "queryType": "promql",
          "queries": [
            {
              "query": "amazonaws_com_3mrai_users_registered_total",
              "customQuery": true,
              "fields": {
                "stream": "amazonaws_com_3mrai_users_registered_total",
                "stream_type": "metrics",
                "x": [],
                "y": [],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "registrations",
                "layer_type": "scatter",
                "weight_fixed": 1
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
