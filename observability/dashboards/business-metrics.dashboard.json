        {
          "id": "emails_failed_by_kind",
          "type": "line",
          "title": "Email failures — permanent vs transient",
          "description": "PERMANENT means the email is LOST: a missing template raises PermanentError, the record is not retried, and the customer never receives it. Any non-zero permanent value is a real incident. TRANSIENT is an SES failure SQS retries, so small numbers are expected noise. Empty while nothing is failing, which is the healthy state.",
          "config": {
            "show_legends": true,
            "decimals": 0,
            "legends_position": "bottom"
          },
          "queryType": "promql",
          "queries": [
            {
              "query": "sum by (dimensions_failurekind) (amazonaws_com_3mrai_emails_failed_total{dimensions_emailtype=\"ALL\"})",
