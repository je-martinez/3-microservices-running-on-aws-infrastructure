          "id": "users_registered",
          "type": "line",
          "title": "Users registered",
          "description": "New registrations. Both the password and passwordless paths increment this one counter \u2014 the split is carried by users_total's HasPassword dimension, not by a second metric.",
          "config": {
            "show_legends": false,
            "decimals": 0
          },
          "queryType": "promql",
          "queries": [
