          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT http_route AS x_axis_1, COUNT(*) AS y_axis_1 FROM logs WHERE service_name = 'tracking' AND http_route IS NOT NULL GROUP BY x_axis_1 ORDER BY y_axis_1 DESC",
