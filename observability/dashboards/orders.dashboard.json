          "config": {
            "show_legends": false,
            "decimals": 0
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS x_axis_1, COUNT(*) AS y_axis_1 FROM logs WHERE service_name = 'orders' AND http_route IS NOT NULL GROUP BY x_axis_1",
              "customQuery": true,
              "fields": {
                "stream": "logs",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "time",
