        {
          "id": "orders_latency_pctl",
          "type": "line",
          "title": "Latency p50 / p95 / p99 (ms)",
          "description": "Response time percentiles of duration_ms",
          "config": {
            "show_legends": true,
            "decimals": 2,
            "unit": "milliseconds"
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS x_axis_1, approx_percentile_cont(duration_ms, 0.5) AS y_axis_1, approx_percentile_cont(duration_ms, 0.95) AS y_axis_2, approx_percentile_cont(duration_ms, 0.99) AS y_axis_3 FROM logs WHERE service_name = 'orders' AND duration_ms IS NOT NULL GROUP BY x_axis_1",
