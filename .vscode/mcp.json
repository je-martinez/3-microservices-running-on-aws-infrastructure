{
  "inputs": [],
  "servers": {
    "drawio": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "dlx",
        "@drawio/mcp"
      ]
    },
    "pencil": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "set -a && [ -f .env ] && . ./.env; set +a; exec python3 scripts/pencil_mcp.py"
      ]
    }
  }
}
