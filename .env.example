# .env.example — the committed contract for this repo's environment files.
#
# THIS FILE IS DOCUMENTATION, NOT CONFIG. Nothing loads it. Every real file
# below is generated by `make env-file` and git-ignored, because the values
# change on every `terraform apply`: Floci mints new Cognito ids and a new API
# id, and reassigns the RDS proxy ports by cluster creation order.
#
# GENERATED FILES AND THEIR CONSUMERS
#   .env                        the ONLY four vars docker-compose interpolates as ${VAR}
#   .env.local.infra            terraform outputs — read by the E2E suite and by humans
#   .env.local.users            Users service environment   (compose `env_file:`)
#   .env.local.orders           Orders service environment  (compose `env_file:`)
#   .env.local.tracking         Tracking service environment (compose `env_file:`)
#   .env.local.events-pipeline  events-pipeline environment (compose `env_file:`)
#   .env.local.debug            HOST-reachable connection strings; loaded by nothing
#
# EDITING RULE
# Each generated file has two boxes. `make env-file` rewrites ONLY the
# AUTO-GENERATED one; anything inside CUSTOM survives regeneration. Put your
# overrides and personal tokens in CUSTOM — never edit the AUTO box, it is
# overwritten without warning.
#
# ADDING A SERVICE
# Add a `.env.local.<service>` entry to the generator and an `env_file:` line to
# that service in docker-compose.yml. There is no shared services file: Users
# and Orders both define DATABASE_WRITER_URL with different values AND formats
# (a postgres:// URL versus an ADO connection string), so one file per service
# is what keeps them from colliding.


# ─── .env (root) ──────────────────────────────────────────────────────────────
# Only what docker-compose interpolates. A var referenced as ${VAR} in
# docker-compose.yml but absent here resolves to an EMPTY STRING, not an error —
# so a missing value fails silently. Keep this file minimal and complete.
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxx
USERS_DB_PORT=7001
ORDERS_DB_PORT=7002

# CUSTOM box — e.g. tooling tokens consumed by no service:
# APIDOG_ACCESS_TOKEN=
# APIDOG_PROJECT_ID=


# ─── .env.local.infra ─────────────────────────────────────────────────────────
# Terraform outputs. The E2E suite reads API_GATEWAY_URL from here.
# NOTE the literal `$default` path segment — it is Floci's REST API stage name,
# not a variable. The E2E config loads this with plain dotenv (no expansion)
# precisely so it survives verbatim.
API_GATEWAY_URL=http://localhost:4566/restapis/<api-id>/$default/_user_request_
USERS_DB_HOST=<floci-rds-proxy-ip>
ORDERS_DB_HOST=<floci-rds-proxy-ip>
# Mailpit's HTTP API, host-facing, `/api/v1` prefix included. The odd one out in
# this file: NOT a terraform output, but a fixed constant — Mailpit is a
# docker-compose service whose 8025 port is published by docker-compose.yml, so
# nothing about it changes per apply. The E2E suite reads it to assert that the
# events-pipeline's emails actually arrive; the pipeline's own integration test
# reads the SAME variable name, which is why it is spelled exactly this way.
MAILPIT_API_URL=http://localhost:8025/api/v1
# The events Lambda's E2E email-query route (Function URL), host-facing — the
# suite reads the rendered emails here because DocumentDB's 27017 is not
# published to the host. Floci mints a new <hash> on every apply, so never pin it.
EVENTS_QUERY_URL=http://<hash>.lambda-url.us-east-1.localhost:4566/
# Presented as `x-e2e-token` on that route, which is AuthType NONE and answers
# 404 without it. LOCAL-ONLY fixture secret, not a production credential.
E2E_QUERY_TOKEN=local-e2e-query-token


# ─── .env.local.users ─────────────────────────────────────────────────────────
# AUTO-GENERATED half — reached by compose service name, on the discovered port.
AWS_ENDPOINT_URL=http://floci:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DATABASE_WRITER_URL=postgres://test:test@floci:7001/users
DATABASE_READER_URL=postgres://test:test@floci:7001/users
GRPC_API_KEY=local-dev-grpc-key
#
# The account-deletion cascade (DELETE /v1/users/me). Users calls
# DELETE /v1/orders/by-user and DELETE /v1/trackings/by-user over plain HTTP,
# authenticating with the GRPC_API_KEY above. Neither route is published on the
# API Gateway — they are service-to-service only.
#
# Container-network names and CONTAINER ports: Orders serves 8080 (published to
# the host as 3001, which is not what a peer service dials), Tracking serves 8000.
ORDERS_BASE_URL=http://orders:8080
TRACKING_BASE_URL=http://tracking:8000
#
# Short-lived store for password-reset codes (10-minute TTL), on ElastiCache
# Redis. Not a Postgres table: the codes are regenerable and expire on their
# own, so Redis's native TTL replaces a sweeper job.
#
# REDIS_HOST is the Floci BACKING CONTAINER NAME on the Docker network —
# `floci-valkey-<replication-group-id>`, image valkey/valkey:8, with NO host port
# published. It is NOT the endpoint the ElastiCache API reports: Floci returns
# ConfigurationEndpoint.Address = "localhost", which inside the users container
# resolves to the users container itself. Never "fix" this to localhost. Same
# rule as DOCDB_HOST further down, with one difference — this hostname is
# DETERMINISTIC (the replication group id is chosen in Terraform), so unlike the
# RDS proxy ports it needs no discovery step.
REDIS_HOST=floci-valkey-cache-3mrai-local-cache-redis
REDIS_PORT=6379
#
# Kill switch for the response cache (docs/shared/conventions/x-cache-response-header.md).
# "false" skips the cache interceptor entirely: no Redis call, and NO X-Cache
# header on any response — not even BYPASS, which means "Redis was unavailable",
# a different statement. Present in all three service env files, and lives in
# each one's CUSTOM box so a local choice survives `make env-file`. The A/B load
# test toggles it to measure what the cache is actually buying.
CACHE_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Stated explicitly: the Node and .NET SDK defaults differ and a mismatch fails
# silently. Metrics/logs exporters are off — the collector serves traces only.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# Business metrics do NOT travel over OTLP (hence the `none` above): services
# publish them to CloudWatch with PutMetricData and the collector scrapes them
# from there. This is how often the gauge poller runs. CloudWatch standard
# resolution is 60s; finer metrics are billed separately as high resolution.
METRICS_INTERVAL_MS=60000

# CUSTOM half — seeded once, then yours:
PORT=3000
GRPC_PORT=50051
WEBHOOK_SECRET=local-dev-secret


# ─── .env.local.orders ────────────────────────────────────────────────────────
# Same AWS/OTel values; the DB string is an ADO connection string, not a URL.
# SslMode=None because Floci's MySQL proxy terminates no TLS.
DATABASE_WRITER_URL=Server=floci;Port=7002;Database=orders;User=test;Password=test;SslMode=None;
DATABASE_READER_URL=Server=floci;Port=7002;Database=orders;User=test;Password=test;SslMode=None;
USERS_GRPC_URL=http://users:50051
# Tracking is reached over HTTP, not gRPC — it serves no gRPC surface.
TRACKING_BASE_URL=http://tracking:8000
OTEL_DIAGNOSTICS__LOGLEVEL=Error
# Interval for the orders_total gauge BackgroundService — see the users section.
METRICS_INTERVAL_MS=60000

# CUSTOM half:
SEED_ON_STARTUP=true


# ─── .env.local.tracking ──────────────────────────────────────────────────────
# Go/Gin/sqlc. The DB string keeps the SQLAlchemy `mysql+pymysql://` spelling it
# had under the service's Python predecessor — the Go service parses that prefix
# itself (internal/platform/config/dsn.go), services/tracking-go/Makefile's
# `test-db` reads the same string to discover the port, and .env.local.debug
# derives the host-side URL from it. Same MySQL cluster as Orders, different
# database, hence the same discovered port with /tracking.
DATABASE_WRITER_URL=mysql+pymysql://test:test@floci:7002/tracking?charset=utf8mb4
DATABASE_READER_URL=mysql+pymysql://test:test@floci:7002/tracking?charset=utf8mb4
# Tracking serves no gRPC. Its one gRPC call goes OUT, to Users, resolving the
# caller's usr_ id from the Cognito sub the gateway hands it.
USERS_GRPC_URL=http://users:50051
#
# TWO KEY-BASED AUTH SCHEMES, TWO TRUST DOMAINS — never collapse them into one
# value. GRPC_API_KEY is the INTERNAL shared secret our own services use as
# gRPC `x-api-key`; Users is the only server validating it, and Orders and
# Tracking both present it when calling Users. TRACKING_CARRIER_API_KEY is
# issued to an EXTERNAL shipping carrier for PUT /v1/trackings/{orderId}/status,
# a gateway route with no Cognito authorizer that the service authenticates
# itself. Reusing one as the other would give an outside vendor an
# internal-service credential. Both are local-dev placeholders; prod rotation is
# deferred to ADR-0007 like every other secret.
GRPC_API_KEY=local-dev-grpc-key
TRACKING_CARRIER_API_KEY=local-dev-carrier-key
# Business metrics to CloudWatch. Seconds here, milliseconds in the Node/.NET
# services: each matches its own settings type's natural unit rather than
# forcing one unit across three stacks. METRICS_ENABLED gates the gauge loop —
# the test suite sets it false so a run does not open a database session per test.
METRICS_INTERVAL_SECONDS=60
METRICS_ENABLED=true
# REQUIRED, and unique to this service: config.Load REJECTS any value outside
# development/test/production, so an ABSENT key is a boot failure rather than a
# default. It also decides whether SQL statements are echoed. This key arrived
# with the Go cutover — the Python predecessor inferred the same thing from its
# own settings type and needed nothing in the environment.
ENVIRONMENT=development

# CUSTOM half:
PORT=8000
# Gates the flag-guarded E2E routes — for Tracking, DELETE /v1/trackings/
# e2e-cleanup, which the E2E harness's global teardown calls. Users and Orders
# carry the same variable for their own cleanup routes. It is required on BOTH
# sides of the tagging mechanism: a row is tagged "E2E Source" at creation only
# when the request sent `x-e2e-source: true` AND this flag is on, and the
# cleanup route is not registered at all without it. That conjunction is what
# stops an untrusted client tagging its own rows. Local-only — never true in a
# deployed environment.
E2E_TESTING_ENABLED=true


# ─── .env.local.events-pipeline ───────────────────────────────────────────────
# Node.js. In prod this runs as a Lambda triggered by SQS; here it's a compose
# container for local dev (hot-reload) — the real local consumer is the
# Terraform-deployed Lambda + event source mapping (see
# functions/events-pipeline/CLAUDE.md). DOCDB_HOST is the Floci-backing
# container name, NEVER an IP or `localhost` — port 27017 is not published to
# the host in our containerized Floci setup, and the container IP changes on
# every recreation.
EVENTS_QUEUE_URL=http://localhost:4566/000000000000/<queue-name>
DOCDB_HOST=floci-docdb-<docdb-cluster-identifier>
DOCDB_PORT=27017
DOCDB_USERNAME=docdbadmin
DOCDB_PASSWORD=test
DOCDB_DATABASE=events
# LOCAL ONLY: Floci backs DocumentDB with a stock mongo:7.0 container whose
# root user lives in the `admin` database, not the target database. Without
# this, the driver reports "MongoServerError: Authentication failed"; with it,
# { ok: 1 }. Real Amazon DocumentDB authenticates against the target database
# itself, so production never sets this variable.
DOCDB_AUTH_SOURCE=admin
# Email sent/failed counters to CloudWatch. No interval: this is a Lambda with
# no long-lived process to host a poller, so its metrics are counters published
# during the invocation itself. The DEPLOYED function gets this from main.tf's
# environment_variables block; the value here serves the package's own tests.
METRICS_ENABLED=true
SES_FROM_ADDRESS=no-reply@3mrai.local
#
# --- WebSocket realtime events (generated) ---
# Connections registry written by the $connect/$disconnect handlers and read by
# the events-pipeline fan-out. The DEPLOYED Lambda receives these from
# Terraform's environment_variables, not from this file — there is no
# events-pipeline compose service; they are mirrored here for the package's own
# tests and manual runs, exactly like the DOCDB_* values above.
WS_CONNECTIONS_TABLE=3mrai-local-realtime-ws-connections
# The GSI hash key is cognito_sub, NOT the internal usr_ id: querying it with a
# user_id returns zero rows and no error at all.
WS_CONNECTIONS_GSI=by-cognito-sub
# Floci's @connections endpoint carries an UNDOCUMENTED /execute-api/ prefix and
# differs from real AWS (https://{apiId}.execute-api.{region}.amazonaws.com/
# {stage}). A wrong value answers HTTP 400 with an S3 XML body — unrouted :4566
# paths fall through to Floci's S3 handler — not an obvious endpoint error.
# IN-NETWORK `floci`, never `localhost`: only a Lambda container reads it.
WS_MANAGEMENT_ENDPOINT=http://floci:4566/execute-api/<ws-api-id>/dev
#
# --- functions/realtime-events (Terraform-supplied only, no mirror file) ---
# The four WebSocket Lambdas (authorizer/$connect/$disconnect/$default) are
# NOT a compose service and have no .env.local.* file of their own — they get
# every variable straight from modules/api-gateway-ws/main.tf's
# environment{variables} block, generated from nothing (no generate_env_files.py
# entry exists for this package). Documented here anyway, next to the values
# it's most related to, so the contract stays visible even without a mirror.
#
# The $connect authorizer's JWT issuer — CONFIGURATION, never derived inside
# the Lambda from COGNITO_USER_POOL_ID/region. Real AWS Cognito's issuer shape
# (https://cognito-idp.<region>.amazonaws.com/<pool-id>) does not hold
# locally: Floci stamps a FIXED http://localhost:4566/<pool-id> `iss` claim on
# every token it mints, regardless of which host/AWS_ENDPOINT_URL the calling
# SDK used to reach it. Sourced from module.cognito.issuer
# (infra/modules/cognito/outputs.tf) — the SAME value the REST API Gateway's
# native JWT authorizer already consumes (modules/api-gateway/main.tf's
# cognito_issuer) — so both surfaces agree on one source of truth.
COGNITO_ISSUER=http://localhost:4566/us-east-1_xxxxxxxxx


# ─── .env.local.debug ─────────────────────────────────────────────────────────
# HOST-reachable, for a SQL client running outside Docker. Loaded by no service:
# `localhost` inside a container would not resolve to Floci.
USERS_DATABASE_URL=postgres://test:test@localhost:7001/users
ORDERS_DATABASE_URL=mysql://test:test@localhost:7002/orders
# The WebSocket data plane, read by the realtime E2E harness. Host-facing, hence
# this file rather than .env.local.infra.
# ws://localhost:4566/ws/{apiId}/{stage} — NOT the
# restapis/.../_user_request_/ shape API_GATEWAY_URL uses.
WS_URL=ws://localhost:4566/ws/<ws-api-id>/dev
