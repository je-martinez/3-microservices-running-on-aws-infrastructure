# .env.example — the committed contract for this repo's environment files.
#
# THIS FILE IS DOCUMENTATION, NOT CONFIG. Nothing loads it. Every real file
# below is generated by `make env-file` and git-ignored, because the values
# change on every `terraform apply`: Floci mints new Cognito ids and a new API
# id, and reassigns the RDS proxy ports by cluster creation order.
#
# GENERATED FILES AND THEIR CONSUMERS
#   .env                        the ONLY four vars docker-compose interpolates as ${VAR}
#   .env.local.infra            terraform outputs — read by the E2E suite and by humans
#   .env.local.users            Users service environment   (compose `env_file:`)
#   .env.local.orders           Orders service environment  (compose `env_file:`)
#   .env.local.tracking         Tracking service environment (compose `env_file:`)
#   .env.local.events-pipeline  events-pipeline environment (compose `env_file:`)
#   .env.local.debug            HOST-reachable connection strings; loaded by nothing
#
# EDITING RULE
# Each generated file has two boxes. `make env-file` rewrites ONLY the
# AUTO-GENERATED one; anything inside CUSTOM survives regeneration. Put your
# overrides and personal tokens in CUSTOM — never edit the AUTO box, it is
# overwritten without warning.
#
# ADDING A SERVICE
# Add a `.env.local.<service>` entry to the generator and an `env_file:` line to
# that service in docker-compose.yml. There is no shared services file: Users
# and Orders both define DATABASE_WRITER_URL with different values AND formats
# (a postgres:// URL versus an ADO connection string), so one file per service
# is what keeps them from colliding.


# ─── .env (root) ──────────────────────────────────────────────────────────────
# Only what docker-compose interpolates. A var referenced as ${VAR} in
# docker-compose.yml but absent here resolves to an EMPTY STRING, not an error —
# so a missing value fails silently. Keep this file minimal and complete.
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxx
USERS_DB_PORT=7001
ORDERS_DB_PORT=7002

# CUSTOM box — e.g. tooling tokens consumed by no service:
# APIDOG_ACCESS_TOKEN=
# APIDOG_PROJECT_ID=


# ─── .env.local.infra ─────────────────────────────────────────────────────────
# Terraform outputs. The E2E suite reads API_GATEWAY_URL from here.
# NOTE the literal `$default` path segment — it is Floci's REST API stage name,
# not a variable. The E2E config loads this with plain dotenv (no expansion)
# precisely so it survives verbatim.
API_GATEWAY_URL=http://localhost:4566/restapis/<api-id>/$default/_user_request_
USERS_DB_HOST=<floci-rds-proxy-ip>
ORDERS_DB_HOST=<floci-rds-proxy-ip>


# ─── .env.local.users ─────────────────────────────────────────────────────────
# AUTO-GENERATED half — reached by compose service name, on the discovered port.
AWS_ENDPOINT_URL=http://floci:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
DATABASE_WRITER_URL=postgres://test:test@floci:7001/users
DATABASE_READER_URL=postgres://test:test@floci:7001/users
GRPC_API_KEY=local-dev-grpc-key
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Stated explicitly: the Node and .NET SDK defaults differ and a mismatch fails
# silently. Metrics/logs exporters are off — the collector serves traces only.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# CUSTOM half — seeded once, then yours:
PORT=3000
GRPC_PORT=50051
WEBHOOK_SECRET=local-dev-secret


# ─── .env.local.orders ────────────────────────────────────────────────────────
# Same AWS/OTel values; the DB string is an ADO connection string, not a URL.
# SslMode=None because Floci's MySQL proxy terminates no TLS.
DATABASE_WRITER_URL=Server=floci;Port=7002;Database=orders;User=test;Password=test;SslMode=None;
DATABASE_READER_URL=Server=floci;Port=7002;Database=orders;User=test;Password=test;SslMode=None;
USERS_GRPC_URL=http://users:50051
# Tracking is reached over HTTP, not gRPC — it serves no gRPC surface.
TRACKING_BASE_URL=http://tracking:8000
OTEL_DIAGNOSTICS__LOGLEVEL=Error

# CUSTOM half:
SEED_ON_STARTUP=true


# ─── .env.local.tracking ──────────────────────────────────────────────────────
# Python/FastAPI, so the DB string is a SQLAlchemy DSN — same MySQL cluster as
# Orders, different database, hence the same discovered port with /tracking.
DATABASE_WRITER_URL=mysql+pymysql://test:test@floci:7002/tracking?charset=utf8mb4
DATABASE_READER_URL=mysql+pymysql://test:test@floci:7002/tracking?charset=utf8mb4
# Tracking serves no gRPC. Its one gRPC call goes OUT, to Users, resolving the
# caller's usr_ id from the Cognito sub the gateway hands it.
USERS_GRPC_URL=http://users:50051
#
# TWO KEY-BASED AUTH SCHEMES, TWO TRUST DOMAINS — never collapse them into one
# value. GRPC_API_KEY is the INTERNAL shared secret our own services use as
# gRPC `x-api-key`; Users is the only server validating it, and Orders and
# Tracking both present it when calling Users. TRACKING_CARRIER_API_KEY is
# issued to an EXTERNAL shipping carrier for PUT /v1/trackings/{orderId}/status,
# a gateway route with no Cognito authorizer that the service authenticates
# itself. Reusing one as the other would give an outside vendor an
# internal-service credential. Both are local-dev placeholders; prod rotation is
# deferred to ADR-0007 like every other secret.
GRPC_API_KEY=local-dev-grpc-key
TRACKING_CARRIER_API_KEY=local-dev-carrier-key

# CUSTOM half:
PORT=8000
# Gates the flag-guarded E2E routes — for Tracking, DELETE /v1/trackings/
# e2e-cleanup, which the E2E harness's global teardown calls. Users and Orders
# carry the same variable for their own cleanup routes. It is required on BOTH
# sides of the tagging mechanism: a row is tagged "E2E Source" at creation only
# when the request sent `x-e2e-source: true` AND this flag is on, and the
# cleanup route is not registered at all without it. That conjunction is what
# stops an untrusted client tagging its own rows. Local-only — never true in a
# deployed environment.
E2E_TESTING_ENABLED=true


# ─── .env.local.events-pipeline ───────────────────────────────────────────────
# Node.js. In prod this runs as a Lambda triggered by SQS; here it's a compose
# container for local dev (hot-reload) — the real local consumer is the
# Terraform-deployed Lambda + event source mapping (see
# functions/events-pipeline/CLAUDE.md). DOCDB_HOST is the Floci-backing
# container name, NEVER an IP or `localhost` — port 27017 is not published to
# the host in our containerized Floci setup, and the container IP changes on
# every recreation.
EVENTS_QUEUE_URL=http://localhost:4566/000000000000/<queue-name>
DOCDB_HOST=floci-docdb-<docdb-cluster-identifier>
DOCDB_PORT=27017
DOCDB_USERNAME=docdbadmin
DOCDB_PASSWORD=test
DOCDB_DATABASE=events
# LOCAL ONLY: Floci backs DocumentDB with a stock mongo:7.0 container whose
# root user lives in the `admin` database, not the target database. Without
# this, the driver reports "MongoServerError: Authentication failed"; with it,
# { ok: 1 }. Real Amazon DocumentDB authenticates against the target database
# itself, so production never sets this variable.
DOCDB_AUTH_SOURCE=admin
SES_FROM_ADDRESS=no-reply@3mrai.local


# ─── .env.local.debug ─────────────────────────────────────────────────────────
# HOST-reachable, for a SQL client running outside Docker. Loaded by no service:
# `localhost` inside a container would not resolve to Floci.
USERS_DATABASE_URL=postgres://test:test@localhost:7001/users
ORDERS_DATABASE_URL=mysql://test:test@localhost:7002/orders
