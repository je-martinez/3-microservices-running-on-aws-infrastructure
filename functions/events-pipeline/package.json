{
  "name": "@3mrai/events-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "imports": {
    "#shared/*": {
      "types": "./src/shared/*.ts",
      "development": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    },
    "#pipeline/*": {
      "types": "./src/pipeline/*.ts",
      "development": "./src/pipeline/*.ts",
      "default": "./dist/pipeline/*.js"
    },
    "#domain/*": {
      "types": "./src/domain/*.ts",
      "development": "./src/domain/*.ts",
      "default": "./dist/domain/*.js"
    },
    "#email/*": {
      "types": "./src/email/*.ts",
      "development": "./src/email/*.ts",
      "default": "./dist/email/*.js"
    },
    "#handlers/*": {
      "types": "./src/handlers/*.ts",
      "development": "./src/handlers/*.ts",
      "default": "./dist/handlers/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run typecheck && node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "email": "email dev --dir emails --port 3000"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1075.0",
    "@aws-sdk/client-sqs": "^3.1075.0",
    "@react-email/components": "^0.5.0",
    "@react-email/render": "^1.1.0",
    "mongodb": "^6.12.0",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-email/preview-server": "4.3.2",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "react-email": "4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.0.0"
  }
}
