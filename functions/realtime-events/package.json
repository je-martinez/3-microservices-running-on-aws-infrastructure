    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.0.0"
  }
