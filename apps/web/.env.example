# Whether the Stripe payment path is offered at checkout.
# false -> "Checkout — Payment" (design frame DOtD2)
# true  -> the Stripe step in the cart drawer (design frame hed4V)
# PUBLIC: compiled into the bundle. Never put a secret key in an NG_APP_* var.
NG_APP_STRIPE_ENABLED=false

# Base path every gateway call hangs off. RELATIVE on purpose, and effectively
# fixed: nothing in this repo sends CORS headers, so the browser must stay
# same-origin. nginx (apps/web/nginx.conf) and `ng serve`
# (apps/web/proxy.conf.mjs) both proxy /v1 through to the API gateway.
# PUBLIC like every NG_APP_*, but there is nothing secret in a path.
NG_APP_API_GATEWAY_URL=/v1

# Whether the address autocomplete is offered at checkout. A FLAG ONLY — the
# Geoapify API key is NOT here and must never be: an NG_APP_* value is compiled
# into the bundle and readable in devtools. The key is server-side, read from
# GEOAPIFY_API_KEY in .env.local.web (CUSTOM box) by nginx in the container and
# by apps/web/proxy.conf.mjs under `ng serve`.
NG_APP_GEOCODE_ENABLED=false
