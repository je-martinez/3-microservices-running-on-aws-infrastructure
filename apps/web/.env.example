# apps/web/.env.example — DOCUMENTATION only, for `pnpm dev`. The docker image
# builds from the root .env instead. See [[env-files]]
# WARNING: Every NG_APP_* is compiled into the bundle — never put a secret in one.
# CONTRACT: Restart the dev server after changing any of these — they are inlined
# at BUILD time, so a browser reload re-serves the old values.

NG_APP_STRIPE_ENABLED=false

# CONTRACT: The PUBLISHABLE pk_ key only — an sk_ or rk_ key here is readable in
# devtools. Empty counts as UNSET: card entry stays hidden even with the flag on.
NG_APP_STRIPE_PUBLISHABLE_KEY=

# CONTRACT: Keep this RELATIVE — no CORS headers exist anywhere, so the browser
# must stay same-origin.
NG_APP_API_GATEWAY_URL=/v1

# CONTRACT: A flag only — the Geoapify key is server-side (GEOAPIFY_API_KEY in
# ../../.env.local.web). Flag on with no key: the proxy answers 503.
NG_APP_GEOCODE_ENABLED=false

# CONTRACT: The HOST-facing url, NOT WS_MANAGEMENT_ENDPOINT — that one answers a
# browser handshake with an S3 XML body. Copy WS_URL from ../../.env.local.web;
# empty leaves the socket unopened and only warns in the console.
NG_APP_WS_URL=

# CONTRACT: Needs `make observability-up` too — with the collector down every
# export fails silently.
NG_APP_RUM_ENABLED=false
