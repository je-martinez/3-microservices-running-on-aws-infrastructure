.cursor/rules/scripting-language.mdc
.cursor/rules/testing.mdc
.cursor/skills/floci
.cursor/skills/terraform-skill
.gemini/settings.json
.gemini/skills/floci
.gemini/skills/terraform-skill
.github/instructions/documentation-vault.instructions.md
.github/instructions/env-files.instructions.md
.github/instructions/git-and-commits.instructions.md
.github/instructions/language-and-scope.instructions.md
.github/instructions/logging-and-pii.instructions.md
.github/instructions/scripting-language.instructions.md
.github/instructions/testing.instructions.md
.github/skills/floci
.github/skills/terraform-skill
.opencode/rules
.vscode/mcp.json
.windsurf/rules/documentation-vault.md
.windsurf/rules/env-files.md
.windsurf/rules/git-and-commits.md
.windsurf/rules/language-and-scope.md
