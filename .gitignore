# Ignore all configuration settings, themes, and community plugins
.obsidian/

# Ignore system junk files
.trash/
.DS_Store

# Superpowers
.superpowers/

# Ministack local state & data (created at runtime by docker-compose)
/data/

# Node / pnpm
node_modules/
.pnpm-store/
# TypeScript build artifacts
dist/
**/dist/
# Prisma v7 generated client (prisma-client generator output, see schema.prisma)
services/*/src/generated/
# Env files (local secrets — never version). All of these are GENERATED by
# `make env-file` from terraform outputs, so they carry values that change on
# every apply and must not be committed.
.env
.env.*
# ...except the committed contract: what each file holds, which box is safe to
# edit, and what a new service must add. Documentation only — nothing loads it.
!.env.example

# Asset manifest — GENERATED by `make assets-sync` (or `make post-infra`), never
# hand-edited. Ignored for exactly the reasons `.env*` above is: it is derived
# output, and every value in it is environment-specific. Locally it carries
# Floci's path-style http://localhost:4566/<bucket>/... URLs, where the bucket
# name is minted per environment; a production run against the same assets would
# produce entirely different (eventually CloudFront) URLs for the same keys.
# Committing it would mean the file in git is wrong for whoever reads it next,
# and every sync would show up as a diff nobody wants to review.
#
# The INPUTS stay committed — assets/img/*.png is the source of truth, and the
# manifest is reproducible from them in one command. Consumers that need to know
# the shape read the checked-in example, not the artifact.
assets/assets.manifest.json

# Playwright E2E artifacts
e2e/test-results/

# Email rendering screenshots. Regenerated on every run and inspected by a
# human — they are the OUTPUT of the visual specs, not a committed baseline, so
# versioning them would add binary churn to every template tweak without ever
# being read from git.
e2e/screenshots/

# Terraform state & cache (local environments)
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
.terraform.lock.hcl

# Local-only Cognito client descriptor (modules/cognito manage_client_via_provider
# = false fallback, Floci only — see modules/cognito/main.tf), the DocumentDB
# cluster descriptor (modules/docdb manage_cluster_via_provider = false
# fallback, same pattern), and bootstrap.sh's generated app DB user password
# (local Floci only — never a real secret store).
**/.terraform-cognito/
**/.terraform-docdb/
infra/environments/local/.app-db-secret
infra/environments/local/.orders-app-db-secret

# archive_file build artifact (modules/cognito/main.tf data.archive_file.pre_token)
infra/modules/cognito/pre-token-lambda.zip

# NOTE: .agents/ used to be ignored as an agent-skills CLI mirror. It is now
# lnai's output directory for OpenCode and Codex skills and IS committed — see
# the lnai block below.

# Python (infra scripts). The venv is created by `make scripts-setup`; Terraform
# local-exec and the Makefile call .venv/bin/python by ABSOLUTE path.
.venv/
__pycache__/
*.egg-info/


# lnai — .ai/ is DERIVED from .claude/ (the source of truth). See
# docs/superpowers/specs/2026-08-06-multi-provider-agent-config-sync-design.md
#
# Both .ai/ and the per-provider outputs are COMMITTED, so a fresh clone or a new
# Orca worktree has working config without running a sync first. Two reasons this
# is safe: the output is deterministic (two syncs over unchanged sources produce
# byte-identical files, so no diff noise), and reviewing it shows exactly what a
# convention change delivers to each provider.
#
# .ai/ in particular CANNOT be ignored while the providers are committed: every
# provider's skills/ and AGENTS.md are symlinks INTO .ai/, so ignoring it would
# leave a fresh clone full of dangling links — breaking the very Orca case this
# is meant to serve.
#
# Only the sync manifest stays out: it is machine state, not configuration.
# `make ai-sync-check` fails if any of it drifts from the source.
.ai/.lnai-manifest.json

# lnai-generated
.ai/.lnai-manifest.json
# end lnai-generated
