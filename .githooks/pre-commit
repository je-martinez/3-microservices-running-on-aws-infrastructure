#!/usr/bin/env bash
set -euo pipefail

# WHY: Git invokes extensionless hooks directly before repo tooling is bootstrapped;
# Bash supplies staged-index and cleanup primitives without adding a hook framework.

repo_root=$(git rev-parse --show-toplevel)
merge_head=$(git rev-parse --git-path MERGE_HEAD)

# Merge commits deliberately skip this gate; regular commits remain bypassable through
# Git's native `git commit --no-verify` option.
if [[ -f "$merge_head" ]]; then
  exit 0
fi

# CONTRACT: This list mirrors LANG_BY_SUFFIX and LANG_BY_STEM in
# scripts/validate-comments.py. A suffix the script lints but this case misses is
# gated by `make lint-comments` alone and passes every commit — which is how an
# Angular template kept a narrative block through review.
staged_paths=()
all_staged=()
while IFS= read -r -d '' path; do
  all_staged+=("$path")
  case "$path" in
    *.tf | *.tfvars | *.py | *.ts | *.tsx | *.js | *.mjs | *.jsx | *.cs | *.go | \
    *.html | *.yml | *.yaml | Makefile* | */Makefile* | Dockerfile* | */Dockerfile* | \
    Containerfile* | */Containerfile*)
      staged_paths+=("$path")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z --)

temp_root=$(mktemp -d "${TMPDIR:-/tmp}/3mrai-comment-lint.XXXXXX")
trap 'rm -rf "$temp_root"' EXIT

# CONTRACT: Guard every array expansion with ${#arr[@]}. `set -u` treats an
# empty array as unbound, so a commit touching only unlinted suffixes aborted
# the hook here — after which BOTH linters were skipped and the commit still
# succeeded. A gate that fails open is worse than no gate.
temp_paths=()
if (( ${#staged_paths[@]} > 0 )); then
  for path in "${staged_paths[@]}"; do
    temp_path="$temp_root/$path"
    mkdir -p "$(dirname "$temp_path")"
    git show ":$path" >"$temp_path"
    temp_paths+=("$temp_path")
  done
fi

python_bin="$repo_root/.venv/bin/python"
if [[ ! -x "$python_bin" ]]; then
  python_bin=$(command -v python3 || true)
fi
if [[ -z "$python_bin" ]]; then
  echo "ERROR: Python 3 is required to lint staged code comments" >&2
  exit 1
fi

# CONTRACT: The secret scan reads EVERY staged path, not the comment linter's
# suffix list. A key pasted into a .md, a .json or a shell script is the same
# leak as one in a .ts, and scanning the index rather than the worktree is what
# makes `git add` the moment it is caught.
secret_paths=()
if (( ${#all_staged[@]} > 0 )); then
for path in "${all_staged[@]}"; do
  secret_path="$temp_root/secrets/$path"
  mkdir -p "$(dirname "$secret_path")"
  if git show ":$path" >"$secret_path" 2>/dev/null; then
    secret_paths+=("$secret_path")
  fi
done
fi

if (( ${#secret_paths[@]} > 0 )); then
  "$python_bin" "$repo_root/scripts/validate-secrets.py" \
    --strip "$temp_root/secrets/" \
    "${secret_paths[@]}" || exit 1
fi

if (( ${#staged_paths[@]} == 0 )); then
  exit 0
fi

"$python_bin" "$repo_root/scripts/validate-comments.py" \
  --root "$temp_root" \
  --baseline "$repo_root/scripts/comment-baseline.json" \
  --stale-terms "$repo_root/scripts/comment-stale-terms.json" \
  --strict-narrative \
  "${temp_paths[@]}"
